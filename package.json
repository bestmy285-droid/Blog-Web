{
  "name": "blog-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A fast, accessible personal blog built with Astro.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "validate": "node scripts/validate-content.mjs",
    "prebuild": "npm run validate",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "npm run validate && npm run check",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:report": "playwright show-report",
    "test:all": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.1",
    "@astrojs/rss": "4.0.19",
    "astro": "7.4.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.64.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}

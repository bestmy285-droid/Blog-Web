---
interface Props {
  page: number;
  totalPages: number;
}

const { page, totalPages } = Astro.props;
const previousHref = page === 2 ? '/' : `/page/${page - 1}/`;
const nextHref = `/page/${page + 1}/`;
---

<nav class="pagination" aria-label="Pagination">
  {
    page > 1 ? (
      <a class="pagination-link" href={previousHref} rel="prev">
        ← Newer posts
      </a>
    ) : (
      <span class="pagination-placeholder" />
    )
  }

  <span class="pagination-status">Page {page} of {totalPages}</span>

  {
    page < totalPages ? (
      <a class="pagination-link" href={nextHref} rel="next">
        Older posts →
      </a>
    ) : (
      <span class="pagination-placeholder" />
    )
  }
</nav>
